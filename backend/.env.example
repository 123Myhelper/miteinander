DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=myhelper

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Pending migrations run on startup, except with NODE_ENV=production (then: `npm run migrate`).
# true/false overrides that default.
# MIGRATE_ON_START=false
